{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/schemas/permissions.schema.json",
  "title": "HLA-MEM permission set",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "module", "permissions"],
  "properties": {
    "apiVersion": {"const": "permissions/v1"},
    "kind": {"const": "PermissionSet"},
    "module": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$"
          },
          "description": {"type": "string", "minLength": 4},
          "kind": {"enum": ["query", "write", "admin"]}
        }
      }
    }
  }
}
