{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/schemas/menu.schema.json",
  "title": "HLA-MEM frontend menu",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "module", "menus"],
  "properties": {
    "apiVersion": {"const": "menu/v1"},
    "kind": {"const": "Menu"},
    "module": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "menus": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/menuItem"}}
  },
  "$defs": {
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "route": {"type": "string", "pattern": "^/"},
        "requiredCapability": {
          "type": "string",
          "pattern": "^(?:host\\.[a-z][a-z0-9]*\\.v(0|[1-9][0-9]*)|[a-z][a-z0-9-]*\\.[a-z][a-z0-9]*\\.(?:[a-z][a-z0-9]*\\.)+v(0|[1-9][0-9]*))$"
        },
        "permission": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$"
        },
        "children": {"type": "array", "items": {"$ref": "#/$defs/menuItem"}}
      }
    }
  }
}
