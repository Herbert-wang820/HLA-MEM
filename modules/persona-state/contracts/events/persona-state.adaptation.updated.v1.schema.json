{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/events/persona-state.adaptation.updated.v1.schema.json",
  "title": "persona-state.adaptation.updated.v1",
  "$comment": "Envelope fields are checked by schemas/event-envelope.schema.json; this schema constrains type + data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "type": {
      "const": "persona-state.adaptation.updated.v1"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId",
        "version",
        "jobId",
        "applied",
        "maxStep"
      ],
      "properties": {
        "identityId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "delta",
              "clamped"
            ],
            "properties": {
              "dimension": {
                "type": "string"
              },
              "delta": {
                "type": "number"
              },
              "clamped": {
                "type": "boolean"
              }
            }
          }
        },
        "maxStep": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
