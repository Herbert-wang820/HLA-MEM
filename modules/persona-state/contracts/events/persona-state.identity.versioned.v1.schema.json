{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/events/persona-state.identity.versioned.v1.schema.json",
  "title": "persona-state.identity.versioned.v1",
  "$comment": "Envelope fields are checked by schemas/event-envelope.schema.json; this schema constrains type + data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "type": {
      "const": "persona-state.identity.versioned.v1"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId",
        "version",
        "previousVersion",
        "reasonCode"
      ],
      "properties": {
        "identityId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "previousVersion": {
          "type": "integer",
          "minimum": 0
        },
        "reasonCode": {
          "type": "string"
        }
      }
    }
  }
}
