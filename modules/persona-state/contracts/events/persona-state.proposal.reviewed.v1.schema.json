{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/events/persona-state.proposal.reviewed.v1.schema.json",
  "title": "persona-state.proposal.reviewed.v1",
  "$comment": "Envelope fields are checked by schemas/event-envelope.schema.json; this schema constrains type + data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "type": {
      "const": "persona-state.proposal.reviewed.v1"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "decision",
        "reviewerSubject"
      ],
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        "reviewerSubject": {
          "type": "string"
        }
      }
    }
  }
}
