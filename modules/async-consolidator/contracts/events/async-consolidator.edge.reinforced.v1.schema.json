{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-mem.dev/events/async-consolidator.edge.reinforced.v1.schema.json",
  "title": "async-consolidator.edge.reinforced.v1",
  "$comment": "Envelope fields are checked by schemas/event-envelope.schema.json; this schema constrains type + data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "type": {
      "const": "async-consolidator.edge.reinforced.v1"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "pairCount",
        "appliedCount"
      ],
      "properties": {
        "batchId": {
          "type": "string",
          "format": "uuid"
        },
        "pairCount": {
          "type": "integer",
          "minimum": 0
        },
        "appliedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
