# HLA-MEM local development environment (copy to .env; never commit real secrets)

HLA_ENV=dev
HLA_LOG_LEVEL=INFO

# Development-only trusted identity.  Tenant is NEVER accepted from request
# parameters or ordinary client headers; it comes from the host identity
# provider.  HLA_DEV_PERMISSIONS empty means "all permissions declared by the
# module's contracts/permissions.yaml" (dev adapter only).
HLA_DEV_TENANT_ID=tenant-dev
HLA_DEV_SUBJECT=dev-user
HLA_DEV_PERMISSIONS=

# Backend service ports
HLA_REASONING_ORCHESTRATOR_PORT=8081
HLA_MEMORY_GRAPH_PORT=8082
HLA_PERSONA_STATE_PORT=8083
HLA_ASYNC_CONSOLIDATOR_PORT=8084

# Single web server for the demo: /conversation/ and /admin/ share this port
HLA_WEB_PORT=4173

# Phase 1+ external dependencies (not required in Phase 0; Docker optional)
# memory-graph: graph DSN and name (in-memory placeholder by default)
HLA_MEMORY_GRAPH_STORE_DSN=
HLA_MEMORY_GRAPH_STORE_GRAPH=hla_mem

# persona-state: its own PostgreSQL database/role (never shared)
HLA_PERSONA_STATE_DB_DSN=postgresql://persona_state:persona_state@127.0.0.1:5432/persona_state

# async-consolidator: a second, independent PostgreSQL instance
HLA_ASYNC_CONSOLIDATOR_DB_DSN=postgresql://consolidator:consolidator@127.0.0.1:5433/consolidator

# Compose host ports (do not reuse the same host port for both databases)
HLA_FALKORDB_PORT=6379
HLA_PERSONA_DB_PORT=5432
HLA_CONSOLIDATOR_DB_PORT=5433

# Optional: admin-web upstreams for /internal/upstreams (JSON array)
# UPSTREAMS=[{"module":"memory-graph","url":"http://127.0.0.1:8082"}]

# Minimal demo: model configuration saved by admin-web (contains the API key)
HLA_REASONING_ORCHESTRATOR_LLM_CONFIG_PATH=var/reasoning-orchestrator/llm.json
HLA_REASONING_ORCHESTRATOR_GATE_TAU=0.2
# Optional bootstrap model settings; admin-saved values take precedence
HLA_REASONING_ORCHESTRATOR_LLM_BASEURL=https://api.openai.com/v1
HLA_REASONING_ORCHESTRATOR_LLM_MODEL=gpt-4o-mini
HLA_REASONING_ORCHESTRATOR_LLM_APIKEY=

# Node sidecars: upstream used by /api and admin config proxies
ORCHESTRATOR_URL=http://127.0.0.1:8081
